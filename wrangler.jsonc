// Cloudflare Workers: serves the static site in dist/ (built by `npm run build`), no Worker code.
// Addresses that don't exist get dist/404.html with a 404 status.
{
  "name": "minideas",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
